# The options of a developer build's tools (core/src/dev.rs). Copy this file
# to dev.toml at the top of the repository; cargo xtask install puts it in the
# game folder's eu4-harmony\ next to the core. A section left out takes the
# defaults shown here, and a tool not built in leaves its section unused.

# Logs calls of game functions: the arguments, the text they point to, the
# call site, the return value.
[call-trace]
# RVAs in hex; RVA:N gives the number of arguments, for a leaf function the
# exception directory has no entry for. None by default.
functions = []
# How many of each function's first calls are logged.
calls = 20
# Every call of each function is timed too, into call-times.tsv next to the
# log: its thread, start and end in microseconds, the game's date and its first
# argument.
times = false
# For a function whose first argument points at an object, an offset into it
# whose eight bytes the times record with each call, as
# { "0xb0fa0" = "0x20" }. None by default.
fields = {}

# Answers remote control's memory: what the process holds, by where it lies,
# at no cost between two asks (docs/plans/leak-finding.md). No options.
[memory-account]

# Counts the game's live heap blocks by site and generation, logs at every
# world reset those the earlier sessions left, and answers remote control's
# memory.leftovers, memory.watch, memory.generation, memory.quarantine and
# memory.pages (docs/plans/leak-finding.md). Builds the memory account in too. No
# options.
[heap-census]

# Logs every command the game executes, in its written form.
[command-log]
# The types to log, by the game's names, such as "buildunit"; every type when
# empty.
types = []

[test-switches]
# Startup fails, so that the failure can be tried on a supported game.
fail-startup = false
# Two test notices are shown, so that the notice window can be tried.
test-notice = false
# The game crashes at the first frame of a game, so that what follows a crash
# can be tried.
crash = false
# Framework code panics at the first frame of a game, so that what follows a
# panic can be tried: the log, the notice and the game ended with exit code 3.
panic = false
# The speed-ups left to the game, so that its own code can be measured against
# them: their points are not installed. Each is named by its name, its group or
# "all": pops-polling, fastest-pace and modifier-sums (group "frames"); music,
# lookups, children, opens and listed-folders ("loading");
# background-compression, stored-copy, parallel-saves, save-sum and
# update-thread ("saving"); army-searches ("ai").
game-paths = []
# The speed-ups whose answers are checked against the game's own, named the
# same way; those that can be are music, lookups, listed-folders,
# parallel-saves, army-searches and modifier-sums. Each difference is logged,
# and the startup report counts the answers checked and those that differed.
checked = []
# A subject relation's end is the game's own: its walk of the subject's
# supporters refreshes the subject as it goes, which frees the list it walks,
# so that the defect can be tried; with the heap census's quarantine on, the
# walk then reads the freed list filled with 0xdd and fails at once.
game-ends-dependencies = false
# Every AI country draws from the world's one random generator as the game's
# do, on several threads at once, instead of from a stream of its own, so
# that the repair can be measured against it.
game-shares-ai-draws = false
# The order in which an AI country's top agent has its agents do their day:
# "game" leaves the game's walks; "forward" and "reversed" are the framework's,
# in the game's order or the opposite one, so that whether an agent's day
# depends on another's can be tried in a game started with -seed.
agents-order = "game"
# Commands in the game's written form, posted through the command layer at the
# first frame of every game, each with what came of it in the log, such as
# 'buildunit={ country="FRA" province=183 unit="western_medieval_infantry" }'.
post = []

# Logs what a game function writes to memory that was there before it was
# called: the heap's blocks and eu4.exe's data, by the instruction and the
# calls it was in. The game runs many times slower while it is watched.
[write-watch]
# An RVA in hex, such as "0x74ff30"; none by default.
function = ""
# How many of its first calls on the main thread are watched (with
# reads-before, how many rounds).
calls = 1
# The game days that are to pass one after another before the watch begins.
after-days = 0
# Functions, as RVAs, whose next call before each watched call is watched for
# its reads too; the watched call's writes to what they read are marked.
reads-before = []
# Modules, by file name, whose threads are not held while a call is watched,
# such as the graphics driver's "nvd3dumx.dll".
let-run = []
# The seconds a watched call may go with nothing watched before the watch is
# given up and where the main thread waits is logged; 0 waits for ever.
give-up-after = 30
